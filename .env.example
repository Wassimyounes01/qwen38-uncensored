# Optional. Defaults talk to local Ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:27b-uncensored
# Cheap path is think-off. Set 1 to force think-on.
QWEN_THINK=0
# Context window. 8192 fits a 24 GB card with Q4_K_M. Max useful here is 16384.
QWEN_NUM_CTX=8192
# Set 1 to download Unsloth Q4_K_M GGUF instead of `ollama pull qwen3.6:27b`.
# QWEN_FROM_GGUF=1
