# Optional. Defaults talk to local Ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-uncensored

# Cheap path is think-off. Set 1 to force think-on.
QWEN_THINK=0

# Context window. 8192 fits both Mac Q3_K_M and Windows Q4_K_M comfortably.
# Max useful for 48GB Mac: 16384. For 24GB Windows: 8192.
QWEN_NUM_CTX=8192

# Download GGUF directly instead of ollama pull (any platform).
# QWEN_FROM_GGUF=1

# Override quant: Q3_K_M (Mac default), Q4_K_M (Windows default), IQ4_XS, Q5_K_M, Q6_K, Q8_0
# QWEN_QUANT=Q3_K_M

# Use legacy official weights + system pack instead of abliterated weights.
# QWEN_LEGACY=1
